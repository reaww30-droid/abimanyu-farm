datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Animal {
    id              String    @id @default(uuid())
    tag             String    @unique
    type            String    @default("Sapi")
    breed           String?
    gender          String?
    weight          Float?
    age             Int?
    milkProduction  Float?
    maleCalves      Int?
    femaleCalves    Int?
    lastCalvingDate DateTime?
    lactationStatus String?
    healthStatus    String?   @default("Sehat Walafiat")
    lastVaccineDate DateTime?
    vaccineType     String?
    vetName         String?
    purchasePrice   Float?
    feedCost        Float?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
}